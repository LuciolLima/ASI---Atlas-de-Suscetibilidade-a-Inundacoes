!docker-compose.observability.yml
!Dockerfile
!docker-compose.yaml
!launch.bat
!*.md
!*.txt
!*.yaml
!*.yml
!*.json
!*.toml
!*.cfg
!*.ini
!*.py
!*.ts
!*.tsx
